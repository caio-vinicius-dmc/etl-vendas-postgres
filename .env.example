# cp .env.example .env
# Valores ficticios, so para o ambiente local.

POSTGRES_USER=etl
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=vendas
POSTGRES_HOST=localhost
POSTGRES_PORT=15433

# Onde o extrator procura os arquivos de origem.
DIR_ENTRADA=dados/entrada
DIR_PROCESSADOS=dados/processados

# text  -> log legível no terminal
# json  -> uma linha JSON por evento, para mandar a um coletor de logs
FORMATO_LOG=text
